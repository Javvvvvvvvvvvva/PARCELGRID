{
  "name": "parcelgrid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check:runtime": "node scripts/check-runtime.mjs",
    "predev": "pnpm check:runtime && node scripts/prepare-planning-assets.mjs",
    "dev": "next dev",
    "prebuild": "pnpm check:runtime && node scripts/prepare-planning-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/smoke-interior.mjs",
    "repo:audit": "node scripts/repository-audit.mjs",
    "notices:generate": "node scripts/generate-third-party-notices.mjs",
    "verify": "pnpm check:runtime && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test:browser:registry": "node scripts/smoke-building-registry.mjs",
    "test:browser:intake": "node scripts/smoke-site-intake.mjs",
    "test:browser:storage": "node scripts/smoke-workspace-storage.mjs",
    "test:browser:facade": "node scripts/smoke-facade.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.6.1",
    "@tanstack/react-query": "^5.59.0",
    "@turf/jsts": "2.7.2",
    "@turf/turf": "^7.3.5",
    "busboy": "1.6.0",
    "@xyflow/react": "12.12.1",
    "clsx": "^2.1.1",
    "comlink": "4.4.2",
    "decimal.js": "^10.6.0",
    "dexie": "4.4.7",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "5.11.2",
    "lucide-react": "^0.451.0",
    "next": "15.5.28",
    "papaparse": "^5.7.0",
    "postgres": "^3.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rhino3dm": "8.35.0",
    "suncalc": "2.0.2",
    "tailwind-merge": "^2.5.2",
    "three": "^0.184.0",
    "three-mesh-bvh": "0.9.18",
    "zod": "4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/busboy": "1.5.4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.28",
    "fake-indexeddb": "6.2.5",
    "playwright": "1.62.1",
    "tailwindcss": "^4.0.0-alpha.30",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
