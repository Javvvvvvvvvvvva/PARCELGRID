# PARCELGRID local configuration
# Copy this file to .env.local. Never commit real keys.

# Optional PostgreSQL persistence. Leave blank for the built-in local seed flow.
DATABASE_URL=

# Public-data integrations used by a real address analysis.
MOLIT_SERVICE_KEY=
# Set false when VPN or network policy blocks VWorld. Address lookup then
# continues with Kakao + MOLIT + manual parcel facts and optional GeoJSON.
VWORLD_ENABLED=false
VWORLD_API_KEY=
VWORLD_API_DOMAIN=http://localhost:3000
KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_JS_KEY=

# Optional AI concept rendering. The API key stays server-side.
# A PARCELGRID reference image is mandatory; text-only mass generation is blocked.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
CONCEPT_RENDER_STORAGE_DIR=.parcelgrid-data/concept-renders
# Per-project API request protection for one Node process (1-50).
CONCEPT_RENDER_DAILY_LIMIT=6

# Local `pnpm dev` opens as an explicit local owner when these are blank.
# Shared production requires user-specific accounts. Keep this JSON on one line.
# Each account needs UUID userId/orgId, email, name, organization, organization role,
# optional reviewerRoles, and either a 12+ character password or passwordSha256.
SITE_ACCESS_ACCOUNTS_JSON=
# Dedicated HMAC secret for signed role sessions (32+ random characters in production).
SITE_ACCESS_SESSION_SECRET=
SITE_ACCESS_SESSION_HOURS=12
# Legacy single-workspace preview credential. It does not provide separate user identities.
SITE_ACCESS_PASSWORD=
# Single-process brute-force protection. Use shared KV/DB for multi-instance hosting.
SITE_ACCESS_ATTEMPT_LIMIT=8
SITE_ACCESS_WINDOW_MINUTES=15

# PDF/XLSX/XLS/CSV evidence files are stored locally and never committed.
SOURCE_DOCUMENT_STORAGE_DIR=.parcelgrid-data/source-documents
# Local append-only audit fallback. Production uses DATABASE_URL and DB immutability triggers.
AUDIT_LEDGER_STORAGE_DIR=.parcelgrid-data/audit-ledger
# Immutable local Workspace revisions when PostgreSQL is not configured.
PROJECT_WORKSPACE_STORAGE_DIR=.parcelgrid-data/project-workspaces
