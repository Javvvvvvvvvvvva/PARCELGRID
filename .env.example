# ─── Database ─────────────────────────────────────────────────────────
# Postgres connection string. With docker-compose:
DATABASE_URL=postgresql://parcelgrid:dev_password_change_me@localhost:5432/parcelgrid

# ─── 국토교통부 (MOLIT) ──────────────────────────────────────────────
# Register at https://www.data.go.kr/ and request "국토교통부_아파트매매 실거래자료"
# and "국토교통부_오피스텔 매매 실거래자료". 1-2 business day approval.
MOLIT_SERVICE_KEY=

# ─── V월드 (지적도, 용도지역, 도로, GIS건물통합정보) ───────────────────
# https://www.vworld.kr/dev/v4api.do — free tier 30,000 calls/day
VWORLD_API_KEY=
# VWorld 인증키에 등록한 호출 도메인. 로컬 예: http://localhost:3000
# 배포 환경에서는 실제 서비스 도메인으로 설정.
VWORLD_API_DOMAIN=http://localhost:3000

# ─── 카카오 / NAVER (Geocoding) ──────────────────────────────────────
# Optional but recommended for distance computation in comps analysis.
KAKAO_REST_API_KEY=

# ─── Cron auth ────────────────────────────────────────────────────────
# Vercel Cron uses Authorization: Bearer ${CRON_SECRET}
CRON_SECRET=

# ─── NextAuth ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── Optional: monitoring ─────────────────────────────────────────────
SENTRY_DSN=
